# Bu dosyayı .env.local adıyla kopyala ve değerleri doldur:
#   cp .env.example .env.local
# .env.local dosyası .gitignore içindedir, repoya gitmez.

# Firebase web yapılandırması.
# Firebase konsolu > Project settings > General > Your apps > SDK setup and configuration
# Bu değerler gizli değildir (bkz. docs/FIREBASE_SETUP.md), ama yine de
# her ortam kendi değerlerini kullansın diye burada tutuyoruz.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check için reCAPTCHA Enterprise site anahtarı (yayın ortamı).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# GİZLİ. Yalnızca geliştirmede kullanılır. Boş bırakırsan tarayıcı konsolu
# otomatik bir token üretir. Bu değeri asla commit'leme ve yayına koyma.
VITE_APPCHECK_DEBUG_TOKEN=
